# Copy this file to .env and adjust it. docker-compose.yml passes it to the
# db and web services. All options: https://wanderer.to/run/environment-configuration

# Public URL of your instance, including the port if it is not 80/443.
ORIGIN=http://localhost:3000

# Required
MEILI_MASTER_KEY=
POCKETBASE_ENCRYPTION_KEY=
POCKETBASE_PROXY_SECRET=

PUBLIC_DISABLE_SIGNUP=false
PUBLIC_PRIVATE_INSTANCE=false
PUBLIC_MAP_MAX_POLYLINES=100

# Account that auto-imports trails dropped into ./data/uploads
UPLOAD_USER=
UPLOAD_PASSWORD=

VALHALLA_URL=https://valhalla1.openstreetmap.de
NOMINATIM_URL=https://nominatim.openstreetmap.org
OVERPASS_API_URL=https://overpass-api.de

# Email
# POCKETBASE_SMTP_ENABLED=false
# POCKETBASE_SMTP_SENDER_ADDRESS=
# POCKETBASE_SMTP_SENDER_NAME=
# POCKETBASE_SMTP_HOST=
# POCKETBASE_SMTP_PORT=
# POCKETBASE_SMTP_USERNAME=
# POCKETBASE_SMTP_PASSWORD=
