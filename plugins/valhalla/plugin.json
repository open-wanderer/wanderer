                      "labels": {
                        "en": "Cross",
                        "de": "Cross"
                      }
                    },
                    {
                      "value": "Mountain",
                      "labels": {
                        "en": "Mountain",
                        "de": "Mountainbike"
                      }
                    }
                  ]
                },
                {
                  "key": "bicycle.shortest",
                  "label": "Shortest",
                  "labels": {
                    "en": "Shortest",
                    "de": "Kürzeste Route"
                  },
                  "type": "boolean",
                  "valueType": "boolean",
                  "default": false,
                  "path": [
