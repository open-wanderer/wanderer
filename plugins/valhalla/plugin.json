          "mode": "foot",
          "advanced": true,
          "nativeControlGroups": [
            {
              "key": "pedestrian",
              "label": "Pedestrian",
              "labels": {
                "en": "Pedestrian",
                "de": "Zu Fuß"
              },
              "controls": [
                {
                  "key": "pedestrian.shortest",
                  "label": "Shortest",
                  "labels": {
                    "en": "Shortest",
                    "de": "Kürzeste Route"
                  },
                  "type": "boolean",
                  "valueType": "boolean",
                  "default": false,
                  "path": [
                    "pedestrian",
                    "shortest"
                  ]
                },
                {
                  "key": "pedestrian.use_hills",
                  "label": "Use hills",
                  "labels": {
                    "en": "Use hills",
                    "de": "Hügel berücksichtigen"
                  },
                  "type": "number",
                  "ui": "slider",
                  "valueType": "number",
                  "min": 0,
                  "max": 1,
                  "step": 0.05,
                  "default": 0.5,
                  "path": [
                    "pedestrian",
                    "use_hills"
                  ]
                }
              ]
            }
          ]
        },
        {
