{
  "manifestVersion": "1.0",
  "id": "valhalla",
  "type": "routing",
  "name": "Valhalla",
  "description": "Routes and enriches elevation using a Valhalla service.",
  "version": "0.1.0",
  "runtime": {
    "type": "wasm",
    "entrypoint": "plugin.wasm"
  },
  "capabilities": [
    {
      "name": "route",
      "version": "v1",
      "export": "route_v1"
    },
    {
      "name": "elevation",
      "version": "v1",
      "export": "elevation_v1"
    },
    {
      "name": "maneuvers",
      "version": "v1",
      "export": "maneuvers_v1"
    }
  ],
  "configSchema": [
    {
      "key": "traceMaxShape",
      "type": "number",
      "label": "Trace point limit",
      "default": 16000,
      "min": 2,
      "max": 200000,
      "hidden": true
    },
    {
      "key": "traceMaxDistanceMeters",
      "type": "number",
      "label": "Trace distance limit (meters)",
      "default": 200000,
      "min": 1000,
      "hidden": true
    },
    {
      "key": "traceOverlap",
      "type": "number",
      "label": "Trace batch overlap",
      "default": 10,
      "min": 1,
      "hidden": true
    }
  ],
  "permissions": {
    "network": {
      "connectors": [
        {
          "name": "api",
          "type": "configured",
          "configKey": "valhalla",
          "allowedPathPrefixes": [
            "/route",
            "/height",
            "/trace_route"
          ]
        }
      ]
    },
    "downloads": {
      "maxBytes": 4194304,
      "contentTypes": [
        "application/json"
      ]
    }
  },
  "hostConfig": {
    "connectors": {
      "valhalla": {
        "baseURL": "https://valhalla1.openstreetmap.de",
        "basePath": "",
        "allowPrivate": false
      }
    },
    "routing": {
      "roles": [
        "route",
        "elevation",
        "maneuvers"
      ],
      "defaultProfiles": [
        "pedestrian",
        "bicycle",
        "auto"
      ]
    }
  },
  "metadata": {
    "displayNames": {
      "de": "Valhalla",
      "en": "Valhalla"
    },
    "descriptions": {
      "de": "Berechnet Routen und Höhenprofile über einen Valhalla-Dienst.",
      "en": "Routes and enriches elevation using a Valhalla service."
    },
    "icons": {
      "light": "icon.svg"
    },
    "routing": {
      "version": "v1",
      "roles": [
        "route",
        "elevation",
        "maneuvers"
      ],
      "modes": [
        "foot",
        "bike",
        "motor"
      ],
      "supportsViaRouting": true,
      "supportsAlternatives": true,
      "maxAlternatives": 4,
      "supportsRouteElevation": false,
      "supportsElevation": true,
      "nativeControlDiscovery": {
        "enabled": true,
        "scope": "profile"
      },
      "standardPreferences": [
        {
          "key": "speedPreference",
          "modes": [
            "foot",
            "bike",
            "motor"
          ],
          "comparable": true
        },
        {
          "key": "hillPreference",
          "modes": [
            "foot",
            "bike"
          ],
          "comparable": true
        },
        {
          "key": "maxHikingDifficulty",
          "modes": [
            "foot"
          ],
          "comparable": true
        },
        {
          "key": "roadPreference",
          "modes": [
            "bike"
          ],
          "comparable": true
        },
        {
          "key": "avoidBadSurfaces",
          "modes": [
            "bike"
          ],
          "comparable": true
        },
        {
          "key": "vehicleWidth",
          "modes": [
            "motor"
          ],
          "comparable": true
        },
        {
          "key": "vehicleHeight",
          "modes": [
            "motor"
          ],
          "comparable": true
        }
      ],
      "nativeProfileUpload": {
        "enabled": false
      },
      "categoryMappings": [
        {
