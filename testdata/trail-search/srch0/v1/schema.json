{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://wanderer.to/schemas/srch0/v1",
  "title": "Observed SRCH0 baseline case",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "case_id", "family", "baseline", "dataset_ref", "context", "input", "observed", "stability", "successor_refs", "evidence"],
  "properties": {
    "schema_version": { "const": "wanderer.srch0/v1" },
    "case_id": { "type": "string", "pattern": "^SRCH0-(STATE|PROJECTION|COMPILER|SEARCH|MUTATION|BROWSER)-[0-9]{3,}$" },
    "family": { "enum": ["state", "projection", "compiler", "search", "mutation", "browser"] },
    "baseline": { "$ref": "#/definitions/baseline" },
    "dataset_ref": { "type": "string", "pattern": "^datasets/[a-zA-Z0-9_.-]+\\.json$" },
    "context": {
      "type": "object", "additionalProperties": false,
      "required": ["principal", "locale", "timezone", "preferences", "surface", "consumer"],
      "properties": {
        "principal": { "type": "string", "minLength": 1 },
        "locale": { "type": "string", "minLength": 1 },
        "timezone": { "type": "string", "minLength": 1 },
        "preferences": { "type": "object" },
        "surface": { "type": "string", "minLength": 1 },
        "consumer": { "type": "string", "pattern": "^[a-z][a-z0-9-]+$" }
      }
    },
    "input": {
      "type": "object", "required": ["adapter"],
      "properties": { "adapter": { "type": "string", "minLength": 1 } }
    },
    "observed": {
      "type": "object", "minProperties": 1,
      "properties": {
        "expected": false,
        "allowed_delta": false,
        "delivery_owner": false,
        "activation_gate": false,
        "settings_overrides": false
      }
    },
    "stability": { "enum": ["preserve", "known_gap", "non_contract"] },
    "successor_refs": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^[A-Z][A-Z0-9a-z-]*$" } },
    "evidence": {
      "type": "object", "additionalProperties": false,
      "required": ["code", "coverage"],
      "properties": {
        "code": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["path", "symbol"],
            "properties": {
              "path": { "type": "string", "minLength": 1 },
              "symbol": { "type": "string", "minLength": 1 }
            }
          }
        },
        "method": {
          "type": "string", "minLength": 1,
          "description": "Optionaler dokumentarischer Hinweis zum einzelnen Fall; die Standardmethode steht in der Anleitung."
        },
        "coverage": { "type": "array", "uniqueItems": true, "minItems": 1, "items": { "type": "string", "minLength": 1 } }
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "stability": { "const": "known_gap" } } },
      "then": { "properties": { "successor_refs": { "type": "array", "minItems": 1 } } }
    },
    {
      "if": { "properties": { "stability": { "const": "preserve" } } },
      "then": { "properties": { "successor_refs": { "type": "array", "maxItems": 0 } } }
    }
  ],
  "definitions": {
    "baseline": {
      "type": "object", "additionalProperties": false,
      "required": ["commit", "observed_at", "engine_profiles", "settings_fingerprint"],
      "properties": {
        "commit": { "const": "e9b7a8cade980002acbcf2e2f5b2a083934f29d2" },
        "observed_at": { "const": "2026-09-07" },
        "engine_profiles": { "const": ["meilisearch-1.11.3", "meilisearch-1.36.0"] },
        "settings_fingerprint": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    }
  }
}
