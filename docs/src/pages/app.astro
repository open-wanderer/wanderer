---
import { Image } from "astro:assets";
import PageNav from "../components/page_nav.astro";
import PageFooter from "../components/page_footer.astro";

import mapShot from "../assets/guides/wanderer_app_map_alt.png";
import searchShot from "../assets/guides/wanderer_app_search.png";
import detailShot from "../assets/guides/wanderer_app_trail_detail.png";
import plannerShot from "../assets/guides/wanderer_app_planner.png";
import regionsShot from "../assets/guides/wanderer_app_regions.png";
import newTrailShot from "../assets/guides/wanderer_app_new_trail.png";
import elevationShot from "../assets/guides/wanderer_app_elevation.png";
import trailsShot from "../assets/guides/wanderer_app_trails.png";

import "@fontsource/ibm-plex-sans/400.css";
import "@fontsource/ibm-plex-sans/600.css";
import "@fontsource/ibm-plex-sans/700.css";
import "@fontsource/ibm-plex-mono/400.css";
import "@fontsource/ibm-plex-mono/600.css";

// ─────────────────────────────────────────────────────────────────────────────
// PLACEHOLDERS: the store listings are not published yet. Swap both values
// for the real URLs when the beta ships; nothing else on this page needs to
// change. See PRODUCT.md → "Store links do not exist yet".
// ─────────────────────────────────────────────────────────────────────────────
const APP_STORE_URL = "#app-store-listing-pending";
const PLAY_STORE_URL = "#play-store-listing-pending";

// The route is one real hike: the Emerald Lake loop, 10.93 km with 237 m of
// climbing (the trail on the detail screenshot below). `km` and `gain` drive the
// travelling readout and must stay monotonic up to those totals; `signal` tells
// the story the page is making: coverage is lost four kilometers out on the far
// side of the lake and returns as the deferred upload fires.
const waypoints = [
  {
    n: "01",
    km: "0.80",
    gain: "12",
    signal: "ONLINE",
    eyebrow: "Find trails",
    heading: "Find your next adventure.",
    body: "Search across trails, places, lists and people, including users on instances yours federates with. Filter by category, difficulty, distance or elevation until the right trail turns up.",
    href: "/app/find-trails",
    src: searchShot,
    alt: "Searching across trails, locations and users in the wanderer app",
  },
  {
    n: "02",
    km: "1.70",
    gain: "31",
    signal: "ONLINE",
    eyebrow: "Plan a route",
    heading: "Or draw one that does not exist yet.",
    body: "Tap the map to drop anchors and the routing service connects them along paths that suit your needs: hiking, or one of four biking profiles.",
    href: "/app/plan-a-route",
    src: plannerShot,
    alt: "The wanderer route planner with four anchors set on the map",
  },
  {
    n: "03",
    km: "2.60",
    gain: "52",
    signal: "ONLINE",
    eyebrow: "Record a trail",
    heading: "Or skip the planning and just start walking.",
    body: "Hit record and the app tracks your position with live distance, gain, speed and moving time. It keeps running in the background and needs no network at all.",
    href: "/app/record-a-trail",
    src: newTrailShot,
    alt: "The New Trail screen in the wanderer app",
  },
  {
    n: "04",
    km: "3.60",
    gain: "78",
    signal: "ONLINE",
    eyebrow: "Trail details",
    heading: "However you got it, this is the trail.",
    body: "Read up before you commit: the elevation profile shows exactly what climb is ahead, waypoints flag what's coming and where, and the summit book holds reports from everyone who has already made the trip. A comment about a washed-out bridge is worth more than any stat block.",
    href: "/app/trail-details",
    src: detailShot,
    alt: "A trail's detail page in the wanderer app",
  },
  {
    n: "05",
    km: "4.35",
    gain: "99",
    signal: "1 BAR",
    eyebrow: "Offline use",
    heading: "Take the map with you.",
    body: "No network? No problem. Download the map at home and be prepared for every surprise.",
    href: "/app/offline-use",
    src: regionsShot,
    alt: "The offline regions screen in the wanderer app",
  },
  {
    n: "06",
    km: "5.10",
    gain: "121",
    signal: "NO SIGNAL",
    eyebrow: "Navigate a trail",
    heading: "Navigate the trail",
    body: "Get precise turn by turn navigation instructions. Your route is recorded at the same time so you can simply save it once you are done. And all of this works even if you are offline.",
    href: "/app/navigate-a-trail",
    src: elevationShot,
    alt: "A trail's route map and elevation profile in the wanderer app",
  },
  {
    n: "07",
    km: "9.10",
    gain: "221",
    signal: "SYNCED",
    eyebrow: "Profile",
    heading: "Back in range, and it's already there.",
    body: "The moment your instance is reachable again, the recording uploads on its own: no action needed. Open your profile and it sits in your trails with everything else you've walked, recorded, or planned.",
    href: "/app/profile",
    src: trailsShot,
    alt: "Your trails list, with the hike you just finished already in it",
  },
];

const legs = [
  { start: 0, end: 3, marker: "Leg 01 · three ways to start" },
  { start: 3, end: 6, marker: "Leg 02 · off the grid" },
  // `cue: "sync"` hooks this leg's divider as the point the travelling HUD
  // starts showing a sync icon, earlier than waypoint 07 itself, which is
  // where the HUD instead resolves to a completed checkmark. See the
  // signal-breakpoints block in the route script below.
  { start: 6, end: 7, marker: "Leg 03 · back in range", cue: "sync" },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>wanderer for iOS and Android: your trails, off the grid</title>
    <meta
      name="description"
      content="The wanderer app puts your own instance on your phone: browse and record trails, plan routes, navigate turn-by-turn, and take whole map regions offline."
    />
    <meta property="og:type" content="website" />
    <meta
      property="og:title"
      content="wanderer for iOS and Android: your trails, off the grid"
    />
    <meta
      property="og:description"
      content="Browse and record trails, plan routes, navigate turn-by-turn, and take whole map regions offline. Connects to any wanderer instance."
    />
    <link rel="icon" href="/favicon.svg" />
    <script is:inline>
      // Set before first paint so the pre-reveal state never applies to a
      // visitor whose JavaScript never arrives.
      document.documentElement.classList.add("js");
    </script>
  </head>

  <body>
    <PageNav />

    <!-- ─── HERO ──────────────────────────────────────────────────────────── -->
    <section class="hero">
      <canvas id="hero-topo" aria-hidden="true"></canvas>

      <div class="hero-content">
        <div class="hero-badge">
          <svg
            width="14"
            height="14"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <rect x="6" y="2" width="12" height="20" rx="2.5"></rect>
            <path d="M11 18h2"></path>
          </svg>
          Beta · Expect some rough edges
        </div>

        <h1 class="hero-headline">
          <span class="hero-line">Your trails.</span>
          <span class="hero-line">In your pocket.</span>
          <span class="hero-line">Off the grid.</span>
        </h1>

        <p class="hero-sub">
          The <span class="tracking-[-0.075em]">wanderer</span> app is now available for iOS and Android.
        </p>

        <div class="store-row">
          <a
            class="store-btn"
            href={APP_STORE_URL}
            aria-label="Download wanderer on the App Store"
          >
            <svg
              class="store-glyph"
              width="24"
              height="24"
              viewBox="0 0 24 24"
              fill="currentColor"
              aria-hidden="true"
            >
              <path
                d="M12.152 6.896c-.948 0-2.415-1.078-3.96-1.04-2.04.027-3.91 1.183-4.961 3.014-2.117 3.675-.546 9.103 1.519 12.09 1.013 1.454 2.208 3.09 3.792 3.039 1.52-.065 2.09-.987 3.935-.987 1.831 0 2.35.987 3.96.948 1.637-.026 2.676-1.48 3.676-2.948 1.156-1.688 1.636-3.325 1.662-3.415-.039-.013-3.182-1.221-3.22-4.857-.026-3.04 2.48-4.494 2.597-4.559-1.429-2.09-3.623-2.324-4.39-2.376-2-.156-3.675 1.09-4.61 1.09zM15.53 3.83c.843-1.012 1.4-2.427 1.245-3.83-1.207.052-2.662.805-3.532 1.818-.78.896-1.454 2.338-1.273 3.714 1.338.104 2.715-.688 3.559-1.701"
              ></path>
            </svg>
            <span class="store-btn-text">
              <span class="store-btn-quiet">Download on the</span>
              <span class="store-btn-label">App Store</span>
            </span>
          </a>

          <a
            class="store-btn"
            href={PLAY_STORE_URL}
            aria-label="Get wanderer on Google Play"
          >
            <svg
              class="store-glyph"
              width="24"
              height="24"
              viewBox="0 0 24 24"
              fill="currentColor"
              aria-hidden="true"
            >
              <path
                d="M22.018 13.298l-3.919 2.218-3.515-3.493 3.543-3.521 3.891 2.202a1.49 1.49 0 0 1 0 2.594zM1.337.924a1.486 1.486 0 0 0-.112.568v21.017c0 .217.045.419.124.6l11.155-11.087L1.337.924zm12.207 10.065l3.258-3.238L3.45.195a1.466 1.466 0 0 0-.946-.179l11.04 10.973zm0 2.067l-11 10.933c.298.036.612-.016.906-.183l13.324-7.54-3.23-3.21z"
              ></path>
            </svg>
            <span class="store-btn-text">
              <span class="store-btn-quiet">Get it on</span>
              <span class="store-btn-label">Google Play</span>
            </span>
          </a>
        </div>
      </div>

      <div class="hero-device">
        <div class="app-phone app-phone--hero">
          <div class="app-phone-notch" aria-hidden="true"></div>
          <Image
            src={mapShot}
            alt="The wanderer app showing a selected trail on the map"
            widths={[320, 640]}
            sizes="320px"
            class="app-phone-screen"
            loading="eager"
          />
        </div>
      </div>
    </section>

    <!-- ─── THE ROUTE ─────────────────────────────────────────────────────── -->
    <div class="route">
      <div class="route-spine" aria-hidden="true">
        <div class="route-spine-lit"></div>
      </div>

      <div class="route-marker" aria-hidden="true">
        <span class="route-marker-dot"></span>
        <div class="route-hud">
          <div class="hud-phone">
            <span class="hud-phone-notch"></span>
            <div class="hud-phone-screen">
              <svg class="hud-bars" viewBox="0 0 16 12" data-hud="bars">
                <rect class="hud-bar" x="0" y="8" width="2.4" height="4" rx="0.5"></rect>
                <rect class="hud-bar" x="4.4" y="6" width="2.4" height="6" rx="0.5"></rect>
                <rect class="hud-bar" x="8.8" y="3.4" width="2.4" height="8.6" rx="0.5"></rect>
                <rect class="hud-bar" x="13.2" y="0.8" width="2.4" height="11.2" rx="0.5"></rect>
                <line class="hud-slash" x1="0.5" y1="1" x2="15.5" y2="11"></line>
              </svg>
              <svg class="hud-sync" viewBox="0 0 16 16" data-hud="sync">
                <path
                  d="M13.65 2.35A7.958 7.958 0 0 0 8 0C3.58 0 0 3.58 0 8h2c0-3.31 2.69-6 6-6 1.66 0 3.14.69 4.22 1.78L9 7h7V0l-2.35 2.35z"
                ></path>
                <path
                  d="M14 8c0 3.31-2.69 6-6 6-1.66 0-3.14-.69-4.22-1.78L7 9H0v7l2.35-2.35A7.958 7.958 0 0 0 8 16c4.42 0 8-3.58 8-8h-2z"
                ></path>
              </svg>
              <svg class="hud-check" viewBox="0 0 16 12" data-hud="check">
                <path d="M2 6.4L6.4 10.4L14 1.6"></path>
              </svg>
              <div class="hud-readout">
                <span data-hud="km">KM 0.00</span>
                <span data-hud="gain">&#8593; 0 M</span>
              </div>
              <span class="hud-phone-home"></span>
            </div>
          </div>
        </div>
      </div>

      <!-- ── Trailhead ── -->
      <section class="leg leg--void trailhead" aria-label="Getting started">
        <div class="leg-inner">
          <div class="waypoint waypoint--cap">
            <div class="waypoint-text reveal">
              <p class="node-tag">KM 0.00 &middot; Trailhead</p>
              <h2 class="waypoint-heading">Pick your own server.</h2>
              <p class="waypoint-body">
                Choose which instance to connect to:
                yours, your club's, or a public one. No central service sits in
                between. Log in, or register straight from the app.
              </p>
              <a class="text-link" href="/app/getting-started">
                Getting started
                <svg
                  width="14"
                  height="14"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"></path></svg
                >
              </a>
            </div>

            <div class="waypoint-nodecol">
              <div class="route-node route-node--start" data-km="0.0" data-gain="0" data-signal="ONLINE">
                <span class="sr-only">Trailhead</span>
              </div>
            </div>

            <div class="waypoint-media" aria-hidden="true"></div>
          </div>
        </div>
      </section>

      <!-- ── Legs ── -->
      {
        legs.map((leg, legIndex) => (
          <section
            class:list={[
              "leg",
              legIndex === 1 ? "leg--surface" : "leg--void",
            ]}
            aria-label={leg.marker}
          >
            <div class="leg-inner">
              <div class="leg-marker" data-hud-cue={leg.cue}>
                <span>{leg.marker}</span>
              </div>

              <ol class="waypoints" start={leg.start + 1}>
                {waypoints.slice(leg.start, leg.end).map((wp, i) => (
                  <li
                    class:list={[
                      "waypoint",
                      (leg.start + i) % 2 === 1 && "waypoint--flip",
                    ]}
                  >
                    <div class="waypoint-text reveal">
                      <p class="node-tag">
                        KM {wp.km} &middot; &#8593; {wp.gain} M &middot;{" "}
                        {wp.signal}
                      </p>
                      <h2 class="waypoint-heading">{wp.heading}</h2>
                      <p class="waypoint-body">{wp.body}</p>
                      <a class="text-link" href={wp.href}>
                        {wp.eyebrow}
                        <svg
                          width="14"
                          height="14"
                          viewBox="0 0 24 24"
                          fill="none"
                          stroke="currentColor"
                          stroke-width="2"
                          stroke-linecap="round"
                          stroke-linejoin="round"
                          aria-hidden="true"
                        >
                          <path d="M5 12h14M12 5l7 7-7 7" />
                        </svg>
                      </a>
                    </div>

                    <div class="waypoint-nodecol">
                      <div
                        class="route-node"
                        data-km={wp.km}
                        data-gain={wp.gain}
                        data-signal={wp.signal}
                      >
                        <span class="route-node-num">{wp.n}</span>
                      </div>
                    </div>

                    <div class="waypoint-media reveal">
                      <div class="app-phone">
                        <div class="app-phone-notch" aria-hidden="true" />
                        <Image
                          src={wp.src}
                          alt={wp.alt}
                          widths={[272, 544]}
                          sizes="272px"
                          class="app-phone-screen"
                          loading="lazy"
                        />
                      </div>
                    </div>
                  </li>
                ))}
              </ol>
            </div>
          </section>
        ))
      }

      <!-- ── Summit ── -->
      <section class="leg leg--night summit" aria-label="Download the app">
        <div class="leg-inner">
          <div class="summit-node-row">
            <div
              class="route-node route-node--summit"
              data-km="10.93"
              data-gain="237"
              data-signal="ONLINE"
            >
              <svg width="15" height="15" viewBox="0 0 16 16" aria-hidden="true">
                <rect x="2.2" y="1.8" width="1.5" height="12.4" rx="0.75"></rect>
                <rect x="5" y="2.6" width="2.6" height="2.6"></rect>
                <rect x="10.2" y="2.6" width="2.6" height="2.6"></rect>
                <rect x="7.6" y="5.2" width="2.6" height="2.6"></rect>
                <rect x="5" y="7.8" width="2.6" height="2.6"></rect>
                <rect x="10.2" y="7.8" width="2.6" height="2.6"></rect>
              </svg>
              <span class="sr-only">Summit</span>
            </div>
          </div>

          <div class="summit-close reveal">

              <p class="node-tag">
                KM 10.93 &middot; &#8593; 237 M &middot; Trip complete
              </p>
              <h2 class="summit-heading">
                Everything wanderer does. Now in your pocket.
              </h2>
              <p class="waypoint-body">
                Search, plan, record and navigate trails, online or off. It
                connects to any wanderer instance, including one you run
                yourself. Free, open source, no subscription.
              </p>

              <div class="store-row store-row--summit">
                <a
                  class="store-btn"
                  href={APP_STORE_URL}
                  aria-label="Download wanderer on the App Store"
                >
                  <svg
                    class="store-glyph"
                    width="24"
                    height="24"
                    viewBox="0 0 24 24"
                    fill="currentColor"
                    aria-hidden="true"
                  >
                    <path
                      d="M12.152 6.896c-.948 0-2.415-1.078-3.96-1.04-2.04.027-3.91 1.183-4.961 3.014-2.117 3.675-.546 9.103 1.519 12.09 1.013 1.454 2.208 3.09 3.792 3.039 1.52-.065 2.09-.987 3.935-.987 1.831 0 2.35.987 3.96.948 1.637-.026 2.676-1.48 3.676-2.948 1.156-1.688 1.636-3.325 1.662-3.415-.039-.013-3.182-1.221-3.22-4.857-.026-3.04 2.48-4.494 2.597-4.559-1.429-2.09-3.623-2.324-4.39-2.376-2-.156-3.675 1.09-4.61 1.09zM15.53 3.83c.843-1.012 1.4-2.427 1.245-3.83-1.207.052-2.662.805-3.532 1.818-.78.896-1.454 2.338-1.273 3.714 1.338.104 2.715-.688 3.559-1.701"
                    ></path>
                  </svg>
                  <span class="store-btn-text">
                    <span class="store-btn-quiet">Download on the</span>
                    <span class="store-btn-label">App Store</span>
                  </span>
                </a>

                <a
                  class="store-btn"
                  href={PLAY_STORE_URL}
                  aria-label="Get wanderer on Google Play"
                >
                  <svg
                    class="store-glyph"
                    width="24"
                    height="24"
                    viewBox="0 0 24 24"
                    fill="currentColor"
                    aria-hidden="true"
                  >
                    <path
                      d="M22.018 13.298l-3.919 2.218-3.515-3.493 3.543-3.521 3.891 2.202a1.49 1.49 0 0 1 0 2.594zM1.337.924a1.486 1.486 0 0 0-.112.568v21.017c0 .217.045.419.124.6l11.155-11.087L1.337.924zm12.207 10.065l3.258-3.238L3.45.195a1.466 1.466 0 0 0-.946-.179l11.04 10.973zm0 2.067l-11 10.933c.298.036.612-.016.906-.183l13.324-7.54-3.23-3.21z"
                    ></path>
                  </svg>
                  <span class="store-btn-text">
                    <span class="store-btn-quiet">Get it on</span>
                    <span class="store-btn-label">Google Play</span>
                  </span>
                </a>
              </div>

              <a class="text-link summit-link" href="/app/getting-started">
                Read the app documentation
                <svg
                  width="14"
                  height="14"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"></path></svg
                >
              </a>
          </div>
        </div>
      </section>
    </div>

    <PageFooter />
  </body>
</html>

<style>
  /* ── Reset & Base ───────────────────────────────────────────────────────── */
  *,
  *::before,
  *::after {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }

  html {
    font-size: 16px;
    -webkit-font-smoothing: antialiased;
    scroll-behavior: smooth;
  }

  @media (prefers-reduced-motion: reduce) {
    html {
      scroll-behavior: auto;
    }
  }

  body {
    font-family:
      "IBM Plex Sans",
      -apple-system,
      BlinkMacSystemFont,
      sans-serif;
    background: #12141c;
    color: #ffffff;
    line-height: 1.6;
    min-height: 100vh;
    overflow-x: clip;
  }

  a {
    color: inherit;
  }
  img,
  svg {
    display: block;
    max-width: 100%;
  }

  /* ── Tokens ─────────────────────────────────────────────────────────────── */
  :root {
    --polar-night: #242734;
    --deep-void: #12141c;
    --surface-dark: #1e2028;
    --carbon: #262831;
    --dusk-divide: #374151;
    --summit-fog: #94a3b8;
    --white: #ffffff;
    --signal-red: #ef4444;
    --start-green: #4ade80;
    --route-marker-blue: #2196f3;

    --container: min(1160px, 100% - 3rem);
    --section-py: clamp(4rem, 8vw, 7rem);
    --ease: cubic-bezier(0.33, 1, 0.68, 1);
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  /* ── Shared type ────────────────────────────────────────────────────────── */
  .node-tag {
    font-family: "IBM Plex Mono", monospace;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--summit-fog);
    margin-bottom: 0.875rem;
  }

  .text-link {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    font-size: 0.9375rem;
    font-weight: 500;
    color: var(--white);
    text-decoration: none;
    border-bottom: 1px solid rgba(255, 255, 255, 0.25);
    padding-bottom: 1px;
    transition:
      border-color 0.15s ease,
      color 0.15s ease;
  }
  .text-link:hover {
    border-color: var(--white);
  }
  .text-link:focus-visible {
    outline: 2px solid var(--summit-fog);
    outline-offset: 4px;
    border-radius: 4px;
  }

  /* ── Scroll reveal ──────────────────────────────────────────────────────── */
  .reveal {
    opacity: 1;
    transform: none;
  }

  @media (prefers-reduced-motion: no-preference) {
    :global(html.js) .reveal {
      opacity: 0;
