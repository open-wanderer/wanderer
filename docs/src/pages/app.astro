<script>
  // ── Scroll reveal ─────────────────────────────────────────────────────────
  if (typeof IntersectionObserver !== "undefined") {
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add("is-visible");
            observer.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.18 },
    );
    document.querySelectorAll(".reveal").forEach((el) => observer.observe(el));
  }

  // ── Travelling position marker ────────────────────────────────────────────
  // The marker's place on the spine is the reader's place on the route: the
  // fraction of the route that sits above the middle of the viewport. Every
  // value it reports also exists as static text on the waypoint it belongs to,
  // so a visitor who never sees the marker loses nothing.
  (function () {
    const routeEl = document.querySelector<HTMLElement>(".route");
    const hudEl = document.querySelector<HTMLElement>(".route-hud");
    const kmEl = document.querySelector<HTMLElement>('[data-hud="km"]');
    const gainEl = document.querySelector<HTMLElement>('[data-hud="gain"]');
    if (!routeEl || !hudEl || !kmEl || !gainEl) return;

    // Reassign to typed consts so the narrowing survives into the hoisted
    // functions below.
    const route: HTMLElement = routeEl;
    const hud: HTMLElement = hudEl;
    const hudKm: HTMLElement = kmEl;
    const hudGain: HTMLElement = gainEl;

    // The waypoint copy still says "ONLINE" / "1 BAR" / "NO SIGNAL" /
    // "SYNCED": that text is what the reduced-motion and no-JS reader sees.
    // The HUD reduces those to a reception icon, plus a fifth state ("done")
    // that has no static-copy equivalent: it's purely the HUD's own resolution
    // of "synced" once the reader has scrolled past the waypoint that promised
    // it, so the reduced-motion reader isn't missing information: SYNCED
    // remains what that waypoint states, just without the follow-through.
    const SIGNAL_STATE: Record<string, string> = {
      ONLINE: "full",
      "1 BAR": "low",
      "NO SIGNAL": "none",
      SYNCED: "sync",
    };

    // Leg 3's divider ("LEG 03 · BACK IN RANGE") is tagged as the sync cue:
    // the icon starts spinning there, before the reader ever reaches the
    // waypoint whose copy names synced. See `cue: "sync"` on the legs array.
    const syncCueEl = document.querySelector<HTMLElement>('[data-hud-cue="sync"]');

    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;

    const nodes = Array.from(
      route.querySelectorAll<HTMLElement>(".route-node"),
    );
    if (nodes.length < 2) return;

    type Stop = {
      t: number;
      km: number;
      gain: number;
      signal: string;
      el: HTMLElement;
    };

    type SignalBreakpoint = { t: number; state: string };

    let stops: Stop[] = [];
    let signalBreakpoints: SignalBreakpoint[] = [];
    let routeTop = 0;
    let spineTop = 0;
    let spineHeight = 1;
    let lastSignal = "";
    let scheduled = false;

    function measure(): void {
      const routeRect = route.getBoundingClientRect();
      routeTop = routeRect.top + window.scrollY;

      const centers = nodes.map((node) => {
        const r = node.getBoundingClientRect();
        return r.top + window.scrollY + r.height / 2 - routeTop;
      });

      spineTop = centers[0];
      spineHeight = Math.max(1, centers[centers.length - 1] - spineTop);

      route.style.setProperty("--spine-top", `${spineTop}px`);
      route.style.setProperty("--spine-height", `${spineHeight}px`);

      stops = nodes.map((node, i) => ({
        t: (centers[i] - spineTop) / spineHeight,
        km: Number(node.dataset.km ?? 0),
        gain: Number(node.dataset.gain ?? 0),
        signal: node.dataset.signal ?? "",
        el: node,
      }));

      // Drop the summit's own breakpoint (it's the last stop) so that once the
      // route resolves to "done" there's nothing left to switch it back to a
      // reception state: the checkmark holds all the way to the flag.
      signalBreakpoints = stops
        .slice(0, -1)
        .map((s) => ({ t: s.t, state: SIGNAL_STATE[s.signal] ?? "full" }));

      const syncIdx = stops.findIndex((s) => s.signal === "SYNCED");
      if (syncIdx > 0 && syncIdx < stops.length - 1 && syncCueEl) {
        const cueRect = syncCueEl.getBoundingClientRect();
        const cueT =
          (cueRect.top +
            window.scrollY +
            cueRect.height / 2 -
            routeTop -
            spineTop) /
          spineHeight;

        // Spin the sync icon on from the leg divider, then resolve it to a
        // checkmark exactly where the waypoint's own breakpoint sat.
        signalBreakpoints.splice(syncIdx, 0, { t: cueT, state: "sync" });
        signalBreakpoints[syncIdx + 1].state = "done";
      }
    }

    function signalStateAt(p: number): string {
      let state = signalBreakpoints[0]?.state ?? "full";
      for (const bp of signalBreakpoints) {
        if (p < bp.t) break;
        state = bp.state;
      }
      return state;
    }

    function render(): void {
      const anchor = window.scrollY + window.innerHeight * 0.5;
      const raw = (anchor - (routeTop + spineTop)) / spineHeight;
      const p = raw < 0 ? 0 : raw > 1 ? 1 : raw;

      route.style.setProperty("--p", String(p));
      route.style.setProperty("--marker-y", `${spineTop + p * spineHeight}px`);

      // Hand the ends of the route back to the trailhead bullseye and the
      // summit flag rather than parking the marker on top of them.
      const FADE = 0.015;
      const edge = p < FADE ? p / FADE : p > 1 - FADE ? (1 - p) / FADE : 1;
      route.style.setProperty("--marker-o", edge.toFixed(3));

      // Locate the segment the reader is standing in, then read between its ends.
      let i = 0;
      while (i < stops.length - 2 && p > stops[i + 1].t) i++;

      const from = stops[i];
      const to = stops[i + 1];
      const span = to.t - from.t;
      const local = span > 0 ? Math.min(1, Math.max(0, (p - from.t) / span)) : 0;

      const km = from.km + (to.km - from.km) * local;
      const gain = from.gain + (to.gain - from.gain) * local;

      hudKm.textContent = `KM ${km.toFixed(2)}`;
      hudGain.textContent = `↑ ${Math.round(gain)} M`;

      const state = signalStateAt(p);
      if (state !== lastSignal) {
        hud.dataset.signal = state;
        lastSignal = state;
      }

      for (const stop of stops) {
        stop.el.classList.toggle("is-reached", p >= stop.t);
      }
    }

    function schedule(): void {
      if (scheduled) return;
      scheduled = true;
      requestAnimationFrame(() => {
        scheduled = false;
        render();
      });
    }

    function remeasure(): void {
      measure();
      render();
    }

    measure();
    render();
    route.classList.add("is-live");

    window.addEventListener("scroll", schedule, { passive: true });
    window.addEventListener("resize", remeasure, { passive: true });

    // Lazily-loaded screenshots change the route's height as they land.
    if (typeof ResizeObserver !== "undefined") {
      new ResizeObserver(remeasure).observe(route);
    }
    window.addEventListener("load", remeasure);
  })();

  // ── Hero topo contour background ──────────────────────────────────────────
  (function () {
    const el = document.getElementById("hero-topo");
    if (!(el instanceof HTMLCanvasElement)) return;
    const canvas: HTMLCanvasElement = el;

    const rawCtx = canvas.getContext("2d");
    if (!rawCtx) return;
    const ctx: CanvasRenderingContext2D = rawCtx;

    const reducedMotion = window.matchMedia(
      "(prefers-reduced-motion: reduce)",
    ).matches;

    let w = 0,
      h = 0;
    let rafId: number | null = null;
    let t = 2.4;
    let mouseX = 0.5,
      targetMouseX = 0.5;

    function hash(ix: number, iy: number): number {
      const n = Math.sin(ix * 127.1 + iy * 311.7) * 43758.5453;
      return n - Math.floor(n);
    }
    function smoothstep(x: number): number {
      return x * x * (3 - 2 * x);
    }
    function valueNoise(x: number, y: number): number {
      const xi = Math.floor(x),
        yi = Math.floor(y);
      const xf = x - xi,
        yf = y - yi;
      const u = smoothstep(xf),
        v = smoothstep(yf);
      const a = hash(xi, yi),
        b = hash(xi + 1, yi);
      const c = hash(xi, yi + 1),
        d = hash(xi + 1, yi + 1);
      return a + (b - a) * u + (c - a) * v + (a - b - c + d) * u * v;
    }
    function fbm(x: number, y: number): number {
      const v =
        valueNoise(x, y) * 0.5 +
        valueNoise(x * 2.1 + 1.7, y * 2.1 + 9.2) * 0.25 +
        valueNoise(x * 4.3 + 4.3, y * 4.3 + 2.8) * 0.125;
      return (v / 0.875) * 2 - 1;
    }

    const LEVELS = 24;
    const NOISE_SCALE = 0.0028;
    const AMPLITUDE = 0.095;

    function resize(): void {
      const hero = canvas.closest(".hero");
      if (!(hero instanceof HTMLElement)) return;
      w = canvas.width = hero.offsetWidth;
      h = canvas.height = hero.offsetHeight;
    }

    function drawFrame(): void {
      if (!w || !h) return;
      ctx.clearRect(0, 0, w, h);
      mouseX += (targetMouseX - mouseX) * 0.04;

      for (let i = 0; i < LEVELS; i++) {
        const progress = i / (LEVELS - 1);
        const baseY = h * (0.05 + 0.92 * progress);
        const parallax = (mouseX - 0.5) * w * 0.03 * (0.2 + progress * 0.8);
        const opacity = 0.018 + progress * 0.062;
        const lineW = 0.3 + progress * 0.8;

        ctx.beginPath();
        ctx.strokeStyle = `rgba(255,255,255,${opacity.toFixed(3)})`;
        ctx.lineWidth = lineW;

        const steps = Math.ceil(w / 2.5);
        for (let j = 0; j <= steps; j++) {
          const x = (j / steps) * w;
          const nx = (x + parallax) * NOISE_SCALE + t * 0.07;
          const ny = baseY * NOISE_SCALE * 0.55 + i * 0.18;
          const y = baseY + fbm(nx, ny) * h * AMPLITUDE;
          j === 0 ? ctx.moveTo(x, y) : ctx.lineTo(x, y);
        }
        ctx.stroke();
      }
    }

    function tick(): void {
      t += 0.003;
      drawFrame();
      rafId = requestAnimationFrame(tick);
    }
    function pause(): void {
      if (rafId !== null) {
        cancelAnimationFrame(rafId);
        rafId = null;
      }
    }
    function resume(): void {
      if (!reducedMotion && rafId === null) tick();
    }

    if (typeof ResizeObserver !== "undefined") {
      const hero = canvas.closest(".hero");
      if (hero) new ResizeObserver(resize).observe(hero);
    } else {
      window.addEventListener("resize", resize, { passive: true });
    }

    if (typeof IntersectionObserver !== "undefined") {
      const io = new IntersectionObserver(
        (entries) => {
          entries.forEach((e) => (e.isIntersecting ? resume() : pause()));
        },
        { threshold: 0 },
      );
      io.observe(canvas);
    }

    document.addEventListener(
      "mousemove",
      (e: MouseEvent) => {
        targetMouseX = e.clientX / window.innerWidth;
      },
      { passive: true },
    );

    resize();
    reducedMotion ? drawFrame() : tick();
  })();
</script>
