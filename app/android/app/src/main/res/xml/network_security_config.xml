<?xml version="1.0" encoding="utf-8"?>
<!-- PROXY-03: scoped cleartext exception for the in-app loopback tile proxy.
     Only 127.0.0.1 is permitted cleartext (HTTP) traffic — intentionally no
     app-wide cleartext allowance, so no LAN/hotspot/remote host gains a
     cleartext exception (threat T-25.1-01). -->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
    </domain-config>
</network-security-config>
