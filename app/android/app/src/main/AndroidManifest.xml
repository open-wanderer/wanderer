<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />

    <!-- Required, and load-bearing: tracelet-sdk stops tracking on task
         removal whenever this is missing ("ACCESS_BACKGROUND_LOCATION not
         granted — stopping tracking on task removal"), regardless of
         stopOnTerminate: false. Without it, clearing the app from recents
         silently ends an in-progress recording and drops the foreground
         notification. Android itself would allow the location-type foreground
         service to continue; this is the SDK's own policy, and AppConfig
         exposes no way to opt out of it.
         Requested at runtime by requestBackgroundLocation(), which shows the
         prominent disclosure Play requires before the system prompt. -->
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />

    <!-- tracelet-sdk declares ACTIVITY_RECOGNITION so it can use the hardware
         pedometer for stationary detection. wanderer never requested the
         runtime permission, so it has always run on tracelet's location-based
         fallback anyway ("slightly more battery" per tracelet's docs).
         Declaring it would pull the app into Play's Health apps policy for a
         feature it does not use, so it is stripped from the merged manifest.
         To adopt it later: drop this block, call
         Tracelet.requestMotionAuthorization() alongside the location request,
         clear disableMotionActivityUpdates below, and file the Health apps
         declaration. -->
    <uses-permission
        android:name="android.permission.ACTIVITY_RECOGNITION"
        tools:node="remove" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <application
        android:label="wanderer"
        android:name="${applicationName}"
        android:icon="@mipmap/launcher_icon"
        android:networkSecurityConfig="@xml/network_security_config">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
            <!-- Appear in the share sheet for trail files (GPX/KML/KMZ/TCX/FIT).
                 Many file managers share these as octet-stream/xml, so the
                 generic types are included alongside the specific ones. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <data android:mimeType="application/gpx+xml"/>
                <data android:mimeType="application/vnd.google-earth.kml+xml"/>
                <data android:mimeType="application/vnd.google-earth.kmz"/>
                <data android:mimeType="application/xml"/>
                <data android:mimeType="text/xml"/>
                <data android:mimeType="application/octet-stream"/>
            </intent-filter>
            <!-- "Open with" from file managers. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data android:mimeType="application/gpx+xml"/>
                <data android:mimeType="application/vnd.google-earth.kml+xml"/>
                <data android:mimeType="application/vnd.google-earth.kmz"/>
                <data android:mimeType="application/xml"/>
                <data android:mimeType="text/xml"/>
                <data android:mimeType="application/octet-stream"/>
            </intent-filter>
        </activity>
        <!-- Callback activity for flutter_web_auth_2: catches the OAuth
             redirect relayed from the web app's /login/redirect page via the
             wanderer:// custom scheme. -->
        <activity
            android:name="com.linusu.flutter_web_auth_2.CallbackActivity"
            android:exported="true">
            <intent-filter android:label="wanderer_oauth_callback">
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data android:scheme="wanderer"/>
            </intent-filter>
        </activity>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />

        <meta-data android:name="io.flutter.embedding.android.EnableFlutterGPU" android:value="true" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
        <!-- Required so canLaunchUrl() can see installed map apps (Google Maps,
             OsmAnd, Organic Maps, ...) when opening directions. Without this,
             package visibility hides them and we fall back to the browser. -->
        <intent>
            <action android:name="android.intent.action.VIEW"/>
            <data android:scheme="geo"/>
        </intent>
        <!-- Same, for the browser fallback. -->
        <intent>
            <action android:name="android.intent.action.VIEW"/>
            <data android:scheme="https"/>
        </intent>
    </queries>
</manifest>
